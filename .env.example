# نام و آدرس سایت
SITE_URL=https://sarmayeyar.example.com

# کلید امنیتی نشست‌ها — حتماً در محیط تولید تغییر دهید
SECRET_KEY=change-this-to-a-long-random-string

# دیتابیس — پیش‌فرض SQLite (برای شروع سریع کافی است)
DATABASE_URL=sqlite:///./sarmayeyar.db

# حساب مدیر پیش‌فرض که هنگام اجرای اول ساخته می‌شود
ADMIN_EMAIL=admin@sarmayeyar.local
ADMIN_PASSWORD=ChangeMe123!

# درگاه پرداخت زرین‌پال (اختیاری)
ZARINPAL_MERCHANT_ID=

# کلید API مدل زبانی برای تحلیل عمیق‌تر اخبار (اختیاری)
AI_API_KEY=

# ابزارهای گوگل (اختیاری)
GOOGLE_ANALYTICS_ID=
GOOGLE_SITE_VERIFICATION=
